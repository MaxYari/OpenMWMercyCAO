uniform_float uStrength {
    default = 0.0;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    static = false;
    description = "Overall strength, driven by Mercy while the player is confused";
    display_name = "Strength";
}

fragment confusion {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        float aspect = omw.resolution.x / omw.resolution.y;
        vec2 centered = omw_TexCoord - 0.5;
        centered.x *= aspect;
        float dist = length(centered);

        // Only the screen edges are affected, the centre stays clear
        float edge = smoothstep(0.3, 0.85, dist) * uStrength;
        float time = omw.simulationTime * 0.001;

        // Slow swirl around the centre, stronger towards the edges, plus a gentle wobble
        float angle = edge * 0.06 * sin(time * 1.3 + dist * 5.0);
        float s = sin(angle);
        float c = cos(angle);
        vec2 swirled = vec2(c * centered.x - s * centered.y, s * centered.x + c * centered.y);
        swirled += edge * 0.005 * vec2(sin(time * 2.1 + centered.y * 14.0), cos(time * 1.9 + centered.x * 14.0));
        swirled.x /= aspect;

        vec3 scene = omw_GetLastShader(swirled + 0.5).rgb;

        // Slight desaturation at the edges
        float gray = dot(scene, vec3(0.299, 0.587, 0.114));
        scene = mix(scene, vec3(gray), edge * 0.6);

        omw_FragColor = vec4(scene, 1.0);
    }
}

technique {
    passes = confusion;
    description = "Mercy: Combat AI Overhaul - confusion screen effect";
    author = "MaxYari";
    version = "1.0";
    dynamic = true;
    flags = hidden;
}
